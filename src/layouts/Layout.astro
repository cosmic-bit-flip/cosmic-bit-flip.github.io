---
import '@/styles/global.css'
import '@/styles/typography.css'
import '@/styles/stars-blog.css'
import 'katex/dist/katex.min.css'
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
}

const { class: className } = Astro.props

const pixelStars = [
  [8, 9],
  [16, 19],
  [24, 12],
  [33, 28],
  [42, 14],
  [51, 24],
  [61, 11],
  [70, 30],
  [79, 17],
  [89, 10],
  [95, 27],
  [12, 40],
  [29, 47],
  [46, 38],
  [64, 49],
  [83, 42],
] as const

const starPixels = Array.from({ length: 81 }, (_, index) => {
  const x = index % 9 - 4
  const y = Math.floor(index / 9) - 4
  const distance = Math.abs(x) + Math.abs(y)
  const brightness = [1, 0.8, 0.55, 0.3, 0.12][distance] ?? 0
  return { x, y, opacity: brightness * (x === 0 || y === 0 ? 1 : 0.25) }
}).filter((pixel) => pixel.opacity > 0)

const pixelStarStyles = pixelStars.map(([x, y], index) => {
  const size = 2 + index % 2
  const period = 2.4 + ((index * 31) % 17) / 10
  const phase = ((index * 47) % 360) / 57.3
  const natural = 0.08 + ((index * 13) % 15) / 100
  const blueWeight = 35 + ((index * 19) % 50)
  const color = [146, 197, 213].map((blue, channel) =>
    blue * blueWeight / 100 + [210, 147, 134][channel] * (1 - blueWeight / 100),
  ).join(',')
  const sprite = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="-4 -4 9 9" shape-rendering="crispEdges" fill="rgb(${color})">${starPixels.map(({ x, y, opacity }) => `<rect x="${x}" y="${y}" width="1" height="1" opacity="${opacity}"/>`).join('')}</svg>`

  return {
    x,
    y,
    sprite: `data:image/svg+xml,${encodeURIComponent(sprite)}`,
    style: `--star-size: ${size.toFixed(2)}; --star-period: ${period.toFixed(2)}s; --star-delay: ${(-phase / (Math.PI * 2) * period).toFixed(2)}s; --star-natural: ${natural.toFixed(2)};`,
  }
})
---

<!doctype html>
<html class="bg-background text-foreground" lang={SITE.locale}>
  <Head>
    <slot name="head" />
  </Head>
  <body>
    <!-- Rounded stars below the first cloud bank. -->
    <div class="star-field star-field-rounded" aria-hidden="true">
      <div class="star-small"></div>
      <div class="star-medium"></div>
      <div class="star-large"></div>
      <div class="star-colored"></div>

    </div>
    <div class="star-field star-field-pixel" aria-hidden="true">
      {pixelStarStyles.map(({ x, y, style, sprite }) => (
        <div
          class="pixel-star-layer"
          style={`--pixel-x: ${x}vw; --pixel-y: ${y}vh; ${style}`}
        >
          <img src={sprite} alt="" width="9" height="9" />
        </div>
      ))}
    </div>
    <div class="meteor-field" aria-hidden="true">
      <canvas class="binary-fizz"></canvas>
      {Array.from({ length: 4 }, () => (
        <div class="shooting-star-track">
          <div class="shooting-star"></div>

        </div>
      ))}
    </div>

    <div class="cloud-scene" aria-hidden="true">
      <div class="cloud-layer"></div>
      <div class="cloud-layer"></div>
      <div class="cloud-layer"></div>
      <div class="footer-haze"></div>
      <div class="footer-cloud-bank"></div>
      <div class="footer-cloud-bank"></div>
    </div>

    <script>
  import { scrollPosition } from '@/lib/scroll-position'
      import { createBinaryFizz } from '@/lib/binary-fizz'

      let stopParallax: (() => void) | undefined

      const initParallax = () => {
        stopParallax?.()

        const reduceMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        )
        const boundary = document.querySelector<HTMLElement>('[data-cloud-boundary]')
        const fizz = createBinaryFizz(document.querySelector<HTMLCanvasElement>('.binary-fizz')!)
        const tracks = document.querySelectorAll<HTMLElement>('.shooting-star-track')
        const meteorCleanups = Array.from(
          tracks,
          (track) => {
            const meteor = track.querySelector<HTMLElement>('.shooting-star')!
            let flight: Animation | undefined
            const launch = () => {
              fizz.clear(track)
              flight?.cancel()
              if (reduceMotion.matches) return
              const left = 40 + Math.random() * 56
              const distance = Math.min(window.innerWidth * left / 100 * (0.35 + Math.random() * 0.4), 680)
              const flightAngle = -18 - Math.random() * 30
              const delay = 0.3 + Math.random() * 5
              const cycle = 6 + Math.random() * 4
              const top = 3 + Math.random() * 32
              track.style.left = `${left}%`
              track.style.top = `${top}vh`
              track.style.setProperty('--angle', `${flightAngle}deg`)
              flight = meteor.animate([
                { offset: 0, opacity: 0, transform: 'translateX(0) scaleX(1)' },
                { offset: 0.02, opacity: 0.9 },
                { offset: 0.12, opacity: 0.9 },
                { offset: 0.219, opacity: 0, transform: `translateX(${-distance}px) scaleX(0.12)` },
                { offset: 0.22, opacity: 0, transform: `translateX(${-distance}px) scaleX(0)` },
                { offset: 1, opacity: 0, transform: `translateX(${-distance}px) scaleX(0)` },
              ], { duration: cycle * 1000, delay: delay * 1000, fill: 'both' })
              flight.onfinish = launch
              fizz.launch(track, { left, top, distance, angle: flightAngle, delay, cycle })
            }
            reduceMotion.addEventListener('change', launch)
            launch()
            return () => {
              fizz.clear(track)
              flight?.cancel()
              reduceMotion.removeEventListener('change', launch)
            }
          },
        )
        const layers = document.querySelectorAll<HTMLElement>(
          '.star-field-rounded > :is(.star-small, .star-medium, .star-large, .star-colored)',
        )
        const pixelLayers = document.querySelectorAll<HTMLElement>('.pixel-star-layer')
        const roundedField = document.querySelector<HTMLElement>('.star-field-rounded')!
        const pixelField = document.querySelector<HTMLElement>('.star-field-pixel')!
        const clouds = document.querySelectorAll<HTMLElement>('.cloud-layer')
        const footerClouds = document.querySelectorAll<HTMLElement>('.footer-cloud-bank')
        const haze = document.querySelector<HTMLElement>('.footer-haze')
        const footer = document.querySelector<HTMLElement>('footer')
        const depths = [0.18, 0.32, 0.48, 0.64]
        let cloudTop = 0
        let footerBottom = 0
        let frame = 0
        let easedScroll = Math.max(scrollPosition.y, 0)
        let lastFrame = 0
        let lastCloudScroll = Number.NaN

        const renderParallax = (time: number) => {
          const actualScroll = Math.max(scrollPosition.y, 0)
          const elapsed = lastFrame ? Math.min(time - lastFrame, 64) : 16
          lastFrame = time
          easedScroll = reduceMotion.matches
            ? actualScroll
            : easedScroll + (actualScroll - easedScroll) * (1 - Math.exp(-elapsed / 110))
          if (Math.abs(actualScroll - easedScroll) < 0.1) easedScroll = actualScroll
          const scroll = easedScroll
          layers.forEach((layer, index) => {
            // Each star tile has a second copy one viewport below it.
            const offset = reduceMotion.matches
              ? 0
              : (scroll * depths[index % depths.length]) % scrollPosition.height
            layer.style.transform = `translate3d(0, ${-offset}px, 0)`
          })
          pixelLayers.forEach((layer, index) => {
            const offset = reduceMotion.matches
              ? 0
              : (scroll * depths[index % depths.length]) % scrollPosition.height
            layer.style.transform = `translate3d(0, ${-offset}px, 0)`
          })
          if (actualScroll !== lastCloudScroll) {
            lastCloudScroll = actualScroll
            clouds.forEach((layer, index) => {
              const speed = reduceMotion.matches ? 1 : 0.65 + index * 0.175
              layer.style.transform = `translate3d(0, ${cloudTop + index * 48 - actualScroll * speed}px, 0)`
            })
            const starBoundary = Math.max(0, Math.min(
              scrollPosition.height,
              cloudTop + 80 - actualScroll * (reduceMotion.matches ? 1 : 0.65),
            ))
            roundedField.style.clipPath = `inset(${starBoundary}px 0 0)`
            pixelField.style.clipPath = `inset(0 0 ${scrollPosition.height - starBoundary}px)`
            // Fully clipped stars need no style/paint work until they reenter the sky.
            roundedField.hidden = starBoundary >= scrollPosition.height
            pixelField.hidden = starBoundary <= 0
            fizz.setBoundary(starBoundary)
            const footerTop = footerBottom - 180
            footerClouds.forEach((layer, index) => {
              layer.style.transform = `translate3d(0, ${footerTop + index * 36 - actualScroll}px, 0)`
            })
            if (haze) {
              haze.style.transform = `translate3d(0, ${footerBottom - 360 - actualScroll}px, 0)`
            }
          }

          frame = 0
          if (easedScroll !== actualScroll) {
            frame = window.requestAnimationFrame(renderParallax)
          } else {
            lastFrame = 0
          }
        }

        const requestRender = () => {
          if (!frame) frame = window.requestAnimationFrame(renderParallax)
        }

        const measure = () => {
          lastCloudScroll = Number.NaN
          cloudTop = boundary
            ? boundary.getBoundingClientRect().top + scrollPosition.y
            : scrollPosition.height * 0.48
          footerBottom = footer ? footer.getBoundingClientRect().bottom + scrollPosition.y : 0
          requestRender()
        }

        window.addEventListener('resize', fizz.resize)
        window.addEventListener('scroll', requestRender, { passive: true })
        window.addEventListener('resize', measure)
        const motionChanged = () => {
          lastCloudScroll = Number.NaN
          requestRender()
        }
        reduceMotion.addEventListener('change', motionChanged)
        const observer = new ResizeObserver(measure)
        observer.observe(document.body)
        measure()

        stopParallax = () => {
          meteorCleanups.forEach((cleanup) => cleanup())
          fizz.destroy()
          window.removeEventListener('resize', fizz.resize)
          window.cancelAnimationFrame(frame)
          window.removeEventListener('scroll', requestRender)
          window.removeEventListener('resize', measure)
          reduceMotion.removeEventListener('change', motionChanged)
          observer.disconnect()
        }
      }

      initParallax()
      document.addEventListener('astro:before-swap', () => stopParallax?.())
      document.addEventListener('astro:page-load', initParallax)
    </script>
    <div class="relative z-10 flex h-fit min-h-screen flex-col gap-y-6 font-sans">
      <div class="bg-background/50 sticky top-0 z-50 divide-y backdrop-blur-sm xl:divide-none">
        <Header />
        <slot name="subposts-navigation" />
        <slot name="table-of-contents" />
      </div>
      <main class="grow">
        <div class={cn('mx-auto flex grow flex-col gap-y-6 px-4', className)}>
          <slot />
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>
